# ── Application ──────────────────────────────────────────────
APP_NAME=SafeHeight
BASE_URL=http://localhost:8000
SECRET_KEY=change-me-to-a-long-random-string-in-production

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=sqlite:///./safeheight.db

# ── JWT ───────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
MAGIC_LINK_EXPIRE_MINUTES=15
OTP_EXPIRE_MINUTES=5

# ── Email (SMTP) ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
FROM_NAME=SafeHeight Certification System

# ── Instructor First-Time Setup ───────────────────────────────
# Set this once to bootstrap the first instructor account, then remove it.
INITIAL_INSTRUCTOR_EMAIL=instructor@example.com
INITIAL_INSTRUCTOR_PASSWORD=ChangeMe123!

# ── Google Drive (optional) ───────────────────────────────────
GDRIVE_CREDS_FILE=
GDRIVE_FOLDER_ID=
